@model IEnumerable<OrderDto>
@{
    ViewData["Title"] = "My orders";
    var orders = Model?.ToList() ?? new List<OrderDto>();
    bool autoAcceptEnabled = ViewBag.AutoAcceptEnabled == true;
    string StatusLabel(string status) => status.ToLowerInvariant() switch { "placed" => "Waiting for confirmation", "accepted" => "Confirmed", "shipping" => "Shipping", "completed" => "Completed", "rejected" => "Rejected", "cancelled" => "Cancelled", "no_show" => "No-show", "disputed" => "Under review", _ => status };
    string StatusClass(string status) => status.ToLowerInvariant() switch { "placed" => "pending", "accepted" => "accepted", "completed" => "completed", "rejected" or "cancelled" => "cancelled", _ => "shipping" };
}
<section class="farmer-page">
    <div class="page-heading"><div><span class="eyebrow">SALES MANAGEMENT</span><h1>My orders</h1><p>Track and handle orders from your customers.</p></div><span class="heading-count">@orders.Count @(orders.Count == 1 ? "order" : "orders")</span></div>
    <form asp-controller="Orders" asp-action="SetAutoAccept" method="post" class="card border-0 shadow-sm p-3 mb-3">
        @Html.AntiForgeryToken()
        <div class="d-flex justify-content-between align-items-center gap-3">
            <div><label class="fw-semibold" for="autoAcceptSwitch">Automatically accept orders</label><div class="small text-muted">New orders are accepted after 5 minutes when enough stock is available.</div></div>
            <div class="form-check form-switch fs-4 m-0"><input class="form-check-input" type="checkbox" role="switch" id="autoAcceptSwitch" name="enabled" value="true" checked="@autoAcceptEnabled" onchange="this.form.submit()" /><input type="hidden" name="enabled" value="false" /></div>
        </div>
    </form>
    <form class="order-search" asp-controller="Orders" asp-action="Index" method="get"><label for="phone-search">Search by phone number</label><div class="order-search-controls"><span class="search-icon">⌕</span><input id="phone-search" name="phone" type="tel" value="@ViewBag.Phone" placeholder="Last 3–4 digits or the full phone number" autocomplete="off"/><button type="submit">Find orders</button>@if (!string.IsNullOrWhiteSpace((string?)ViewBag.Phone)) { <a asp-action="Index">Clear filter</a> }</div></form>
    <div class="order-tabs" role="tablist"><button class="order-tab active" data-filter="all">All <span>@orders.Count</span></button><button class="order-tab" data-filter="placed">Waiting for confirmation</button><button class="order-tab" data-filter="accepted">Confirmed</button><button class="order-tab" data-filter="completed">Completed</button><button class="order-tab" data-filter="rejected">Rejected</button><button class="order-tab" data-filter="cancelled">Cancelled</button><button class="order-tab" data-filter="disputed">Under review</button><button class="order-tab" data-filter="no_show">No-show</button></div>
    <div class="orders-list">
    @if (orders.Count == 0) { <div class="empty-state"><span class="empty-icon">▤</span><h2>@(string.IsNullOrWhiteSpace((string?)ViewBag.Phone) ? "No orders yet" : "No orders found")</h2><p>@(string.IsNullOrWhiteSpace((string?)ViewBag.Phone) ? "New orders will appear here." : $"No orders match the phone number {ViewBag.Phone}.")</p></div> }
    @foreach (var order in orders) { var key = StatusClass(order.Status); <article class="order-card" data-status="@order.Status.ToLowerInvariant()"><div class="order-main"><div class="order-card-top"><div><span class="order-code">#@order.OrderCode</span><span class="order-date">@order.ReceiveDate.ToString("dd/MM/yyyy · HH:mm")</span></div><span class="status-pill @key"><i></i>@StatusLabel(order.Status)</span></div><div class="order-customer"><span class="avatar">@((order.CustomerName.FirstOrDefault()).ToString().ToUpper())</span><span><strong>@order.CustomerName</strong><small>@order.CustomerPhone</small></span></div><div class="order-thumbnails">@foreach (var item in order.Items.Take(3)) { <span class="food-thumb">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.ProductName" /> } else { <span>🥬</span> }</span> }@if (order.Items.Count > 3) { <span class="thumb-more">+@(order.Items.Count - 3)</span> }</div></div><div class="order-side"><strong class="order-total">@ShopHelper.Money(order.TotalAmount)</strong><a class="text-action" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">View details <span>→</span></a></div></article> }
    </div>
</section>
@section Scripts { <script>document.querySelectorAll('.order-tab').forEach(tab => tab.addEventListener('click', () => { document.querySelectorAll('.order-tab').forEach(x => x.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('.order-card').forEach(card => card.hidden = tab.dataset.filter !== 'all' && card.dataset.status !== tab.dataset.filter); }));</script> }
