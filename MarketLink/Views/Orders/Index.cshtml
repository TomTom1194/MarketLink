@model IEnumerable<OrderDto>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    ViewData["FarmerSection"] = "orders";
    var orders = Model?.ToList() ?? new List<OrderDto>();
    string StatusLabel(string status) => status.ToLowerInvariant() switch { "placed" => "Chờ xác nhận", "accepted" => "Đã xác nhận", "shipping" => "Đang giao", "completed" => "Hoàn thành", "rejected" => "Đã từ chối", "cancelled" => "Đã hủy", "no_show" => "Không đến nhận", _ => status };
    string StatusClass(string status) => status.ToLowerInvariant() switch { "placed" => "pending", "accepted" => "accepted", "completed" => "completed", "rejected" or "cancelled" => "cancelled", _ => "shipping" };
}
<section class="farmer-page">
    <div class="page-heading"><div><span class="eyebrow">QUẢN LÝ BÁN HÀNG</span><h1>Đơn hàng của tôi</h1><p>Theo dõi và xử lý các đơn hàng từ khách hàng.</p></div><span class="heading-count">@orders.Count đơn hàng</span></div>
    <form class="order-search" asp-controller="Orders" asp-action="Index" method="get"><label for="phone-search">Tìm theo số điện thoại</label><div class="order-search-controls"><span class="search-icon">⌕</span><input id="phone-search" name="phone" type="tel" value="@ViewBag.Phone" placeholder="Nhập 3–4 số cuối hoặc đủ số điện thoại" autocomplete="off"/><button type="submit">Tìm đơn</button>@if (!string.IsNullOrWhiteSpace((string?)ViewBag.Phone)) { <a asp-action="Index">Xóa lọc</a> }</div></form>
    <div class="order-tabs" role="tablist"><button class="order-tab active" data-filter="all">Tất cả <span>@orders.Count</span></button><button class="order-tab" data-filter="placed">Chờ xác nhận</button><button class="order-tab" data-filter="accepted">Đã xác nhận</button><button class="order-tab" data-filter="completed">Hoàn thành</button><button class="order-tab" data-filter="rejected">Đã từ chối</button><button class="order-tab" data-filter="cancelled">Đã hủy</button></div>
    <div class="orders-list">
    @if (orders.Count == 0) { <div class="empty-state"><span class="empty-icon">▤</span><h2>@(string.IsNullOrWhiteSpace((string?)ViewBag.Phone) ? "Chưa có đơn hàng" : "Không tìm thấy đơn hàng")</h2><p>@(string.IsNullOrWhiteSpace((string?)ViewBag.Phone) ? "Đơn hàng mới sẽ xuất hiện tại đây." : $"Không có đơn nào khớp với số điện thoại {ViewBag.Phone}.")</p></div> }
    @foreach (var order in orders) { var key = StatusClass(order.Status); <article class="order-card" data-status="@order.Status.ToLowerInvariant()"><div class="order-main"><div class="order-card-top"><div><span class="order-code">#@order.OrderCode</span><span class="order-date">@order.ReceiveDate.ToString("dd/MM/yyyy · HH:mm")</span></div><span class="status-pill @key"><i></i>@StatusLabel(order.Status)</span></div><div class="order-customer"><span class="avatar">@((order.CustomerName.FirstOrDefault()).ToString().ToUpper())</span><span><strong>@order.CustomerName</strong><small>@order.CustomerPhone</small></span></div><div class="order-thumbnails">@foreach (var item in order.Items.Take(3)) { <span class="food-thumb">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.ProductName" /> } else { <span>🥬</span> }</span> }@if (order.Items.Count > 3) { <span class="thumb-more">+@(order.Items.Count - 3)</span> }</div></div><div class="order-side"><strong class="order-total">@order.TotalAmount.ToString("N0")đ</strong><a class="text-action" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Xem chi tiết <span>→</span></a></div></article> }
    </div>
</section>
@section Scripts { <script>document.querySelectorAll('.order-tab').forEach(tab => tab.addEventListener('click', () => { document.querySelectorAll('.order-tab').forEach(x => x.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('.order-card').forEach(card => card.hidden = tab.dataset.filter !== 'all' && card.dataset.status !== tab.dataset.filter); }));</script> }
