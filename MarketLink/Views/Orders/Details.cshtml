@model OrderDetailDto
@{ ViewData["Title"] = "Chi tiết đơn hàng"; ViewData["FarmerSection"] = "orders"; var status = Model.Status.ToLowerInvariant(); var statusText = status switch { "placed" => "Chờ xác nhận", "accepted" => "Đã xác nhận", "completed" => "Hoàn thành", "rejected" => "Đã từ chối", "cancelled" => "Đã hủy", "no_show" => "Không đến nhận", _ => Model.Status }; var statusClass = status switch { "placed" => "pending", "accepted" => "accepted", "completed" => "completed", "rejected" or "cancelled" => "cancelled", _ => "shipping" }; }
<section class="farmer-page">
    <a class="back-link" asp-action="Index">← <span>Quay lại danh sách</span></a>
    <div class="page-heading detail-heading"><div><span class="eyebrow">THÔNG TIN ĐƠN HÀNG</span><h1>Chi tiết đơn hàng <span class="muted-code">#@Model.OrderCode</span></h1></div><span class="status-pill @statusClass"><i></i>@statusText</span></div>
    <div class="info-grid"><div class="info-card"><span class="info-icon green">♙</span><div><small>Khách hàng</small><strong>@Model.CustomerName</strong><span class="sub-info">SĐT: @Model.CustomerPhone</span></div></div><div class="info-card"><span class="info-icon blue">▦</span><div><small>Ngày nhận hàng</small><strong>@Model.ReceiveDate.ToString("dd/MM/yyyy · HH:mm")</strong><span class="sub-info">Khung giờ khách đã chọn</span></div></div><div class="info-card"><span class="info-icon orange">⌖</span><div><small>Địa chỉ</small><strong>@Model.Address</strong></div></div></div>
    <div class="content-card"><div class="card-heading"><div><h2>Danh sách sản phẩm</h2><p>@Model.Items.Count sản phẩm trong đơn hàng</p></div></div><div class="table-responsive"><table class="order-table"><thead><tr><th>STT</th><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead><tbody>@for (var i = 0; i < Model.Items.Count; i++) { var item = Model.Items[i]; <tr><td class="row-number">@((i + 1).ToString("00"))</td><td><div class="product-cell"><span class="food-thumb">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@item.ProductName" /> } else { <span>🥬</span> }</span><strong>@item.ProductName</strong></div></td><td>@item.Quantity.ToString("0.##") @item.Unit</td><td>@item.UnitPrice.ToString("N0")đ</td><td class="text-end fw-semibold">@item.TotalPrice.ToString("N0")đ</td></tr> }</tbody></table></div><div class="totals"><div><span>Tổng cộng</span><strong>@Model.TotalProductAmount.ToString("N0")đ</strong></div><div><span>Phí giao hàng / điều chỉnh</span><strong>@Model.ShippingFee.ToString("N0")đ</strong></div><div class="grand-total"><span>Thành tiền</span><strong>@Model.TotalAmount.ToString("N0")đ</strong></div></div></div>
    <div class="detail-footer"><a class="btn-soft" asp-action="Index">← Quay lại danh sách</a>@if (status == "placed" || status == "accepted") { <a class="btn-primary-green" asp-action="Process" asp-route-id="@Model.Id">Xử lý đơn hàng <span>→</span></a> }</div>
</section>
