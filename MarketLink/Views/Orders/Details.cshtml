@model OrderDetailDto
@{
    ViewData["Title"] = "Order details";
    OrderDispute? dispute = ViewBag.Dispute;
    bool canReport = ViewBag.CanReport;

    string status = Model.Status.ToLowerInvariant();
    string statusText = status switch
    {
        "placed" => "Waiting for confirmation",
        "accepted" => "Confirmed · Waiting for pickup",
        "completed" => "Completed",
        "rejected" => "Rejected",
        "cancelled" => "Cancelled",
        "no_show" => "No-show",
        "disputed" => "Under review by MarketLink",
        _ => Model.Status
    };
    string statusClass = status switch
    {
        "placed" => "pending",
        "accepted" => "accepted",
        "completed" => "completed",
        "rejected" or "cancelled" => "cancelled",
        _ => "shipping"
    };
}

<section class="farmer-page">
    <a class="back-link" asp-action="Index">← <span>Back to list</span></a>

    <div class="page-heading detail-heading">
        <div>
            <span class="eyebrow">ORDER INFORMATION</span>
            <h1>Order details <span class="muted-code">#@Model.OrderCode</span></h1>
        </div>
        <span class="status-pill @statusClass"><i></i>@statusText</span>
    </div>

    <div class="process-layout">
        @* ===== Left: customer, pickup time and products ===== *@
        <div class="process-summary">
            <div class="info-grid compact">
                <div class="info-card">
                    <span class="info-icon green">♙</span>
                    <div><small>Customer</small><strong>@Model.CustomerName</strong><span class="sub-info">Phone: @Model.CustomerPhone</span></div>
                </div>
                <div class="info-card">
                    <span class="info-icon blue">▦</span>
                    <div><small>Pickup date</small><strong>@Model.ReceiveDate.ToString("dd/MM/yyyy · HH:mm")</strong><span class="sub-info">@Model.Address</span></div>
                </div>
            </div>

            <div class="content-card">
                <div class="card-heading">
                    <div><h2>Products</h2><p>@Model.Items.Count @(Model.Items.Count == 1 ? "product" : "products") in this order</p></div>
                </div>
                <div class="table-responsive">
                    <table class="order-table">
                        <thead>
                            <tr><th>No.</th><th>Product</th><th>Quantity</th><th>Unit price</th><th class="text-end">Amount</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr>
                                    <td class="row-number">@((i + 1).ToString("00"))</td>
                                    <td>
                                        <div class="product-cell">
                                            <span class="food-thumb">
                                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName" />
                                                }
                                                else
                                                {
                                                    <span>🥬</span>
                                                }
                                            </span>
                                            <strong>@item.ProductName</strong>
                                        </div>
                                    </td>
                                    <td>@item.Quantity.ToString("0.##") @item.Unit</td>
                                    <td>@ShopHelper.Money(item.UnitPrice)</td>
                                    <td class="text-end fw-semibold">@ShopHelper.Money(item.TotalPrice)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="totals">
                    <div><span>Subtotal</span><strong>@ShopHelper.Money(Model.TotalProductAmount)</strong></div>
                    <div><span>Adjustment</span><strong>@ShopHelper.Money(Model.ShippingFee)</strong></div>
                    <div class="grand-total"><span>Total</span><strong>@ShopHelper.Money(Model.TotalAmount)</strong></div>
                </div>
            </div>
        </div>

        @* ===== Right: what the farmer can do with this order ===== *@
        <aside class="decision-card">
            <span class="decision-kicker">DECISION</span>

            @if (status == "placed")
            {
                <h2>Do you accept this order?</h2>
                <p>Accepting sets the ordered quantity aside from your stock for this customer.</p>
                <form asp-action="Accept" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn-accept" type="submit"><span>✓</span> Accept order</button>
                </form>

                <div class="decision-divider"><span>or reject the order</span></div>
                <form asp-action="Reject" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="reject-reason">Reason for rejecting</label>
                    <textarea id="reject-reason" name="reason" maxlength="500" placeholder="Tell the customer why..."></textarea>
                    <div class="char-count"><span id="reason-count">0</span>/500</div>
                    <button class="btn-reject" type="submit">Reject order</button>
                </form>
                <div class="decision-hint">The customer will be notified of your decision.</div>
            }
            else if (status == "accepted")
            {
                <h2>Has the customer picked up the order?</h2>
                <p>Only confirm after you have handed over all the products.</p>
                <form asp-action="Complete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn-accept" type="submit"><span>✓</span> Confirm pickup</button>
                </form>
                <div class="decision-hint">An accepted order can no longer be cancelled. Confirming marks the reserved quantity as sold and tells the customer the order is complete.</div>

                <div class="decision-divider"><span>customer did not come</span></div>
                @if (canReport)
                {
                    <form asp-action="Report" method="post" onsubmit="return confirm('Report this customer for not picking up the order? MarketLink will review it.');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="report-reason">What happened?</label>
                        <textarea id="report-reason" name="reason" maxlength="500" required placeholder="e.g. I waited at the stall until 8:00 and the customer did not come or answer the phone"></textarea>
                        <button class="btn-reject" type="submit">Report no-show</button>
                    </form>
                    <div class="decision-hint">The customer will be asked for their side. MarketLink reviews both and decides. The reserved quantity stays aside until then. If nobody reports by @Model.PickupEnd.AddHours(MarketLink.Services.AutoCancelService.WaitHours).ToString("dd/MM/yyyy HH:mm"), the order is cancelled automatically.</div>
                }
                else
                {
                    <div class="decision-hint">You can report a no-show after the pickup time ends (@Model.PickupEnd.ToString("dd/MM/yyyy HH:mm")) and until @Model.PickupEnd.AddHours(MarketLink.Services.AutoCancelService.WaitHours).ToString("dd/MM/yyyy HH:mm"). After that the order is cancelled automatically.</div>
                }
            }
            else if (status == "disputed" && dispute != null)
            {
                <h2>Under review</h2>
                @if (dispute.FarmerReason == null)
                {
                    <p>The customer reported a problem with this pickup. Please send your side before <strong>@dispute.CreatedAt.AddHours(MarketLink.Services.DisputeService.ReplyHours).ToString("dd/MM/yyyy HH:mm")</strong>.</p>
                    <form asp-action="Report" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label for="report-reason">Your side</label>
                        <textarea id="report-reason" name="reason" maxlength="500" required placeholder="e.g. I was at the stall the whole time and had the order ready"></textarea>
                        <button class="btn-accept" type="submit">Send my side</button>
                    </form>
                    <div class="decision-hint">Only MarketLink can see your answer. If we find you were at fault you get a warning, and @MarketLink.Services.DisputeService.MaxWarnings warnings lock your account.</div>
                }
                else
                {
                    <p>You sent your side on @dispute.FarmerReasonAt!.Value.ToString("dd/MM/yyyy HH:mm"). Only MarketLink can see it.</p>
                    <div class="decision-hint">@dispute.FarmerReason</div>
                    <p>MarketLink is checking this order. You will get a notification with the result.</p>
                }
            }
            else if (dispute != null && dispute.Status == "resolved")
            {
                <h2>Review result</h2>
                @if (dispute.AtFault == "farmer")
                {
                    <p>MarketLink found that the problem was on your side. You received a warning.</p>
                }
                else if (dispute.AtFault == "customer")
                {
                    <p>MarketLink found that the customer was at fault. You did not get a warning.</p>
                }
                else
                {
                    <p>MarketLink found a reasonable cause on both sides. No one got a warning.</p>
                }
                @if (!string.IsNullOrEmpty(dispute.AdminNote))
                {
                    <div class="decision-hint">@dispute.AdminNote</div>
                }
                <p>The order was cancelled and the reserved quantity is back on sale.</p>
            }
            else
            {
                <h2>This order has been handled</h2>
                <p>Current status: <strong>@statusText</strong></p>
            }

        </aside>
    </div>
</section>

@section Scripts {
    <script>
        // Live character count for the reject reason
        const reason = document.getElementById('reject-reason');
        if (reason) {
            reason.addEventListener('input', () => document.getElementById('reason-count').textContent = reason.value.length);
        }
    </script>
}
