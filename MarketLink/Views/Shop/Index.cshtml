@model List<Market>
@using MarketLink.Helpers
@{
    ViewData["Title"] = "Choose a market";
    Layout = "_ShopLayout";
    int? selectedMarketId = ViewBag.SelectedMarketId;
    List<MarketDistanceDto>? nearestMarkets = ViewBag.NearestMarkets;
    bool hasLocation = nearestMarkets != null;
    bool hasDistrictFilter = ViewBag.CityId != null || ViewBag.DistrictId != null;

    List<MarketDistanceDto> marketList = new List<MarketDistanceDto>();
    if (nearestMarkets != null)
    {
        marketList = nearestMarkets;
    }
    else if (ViewBag.AllMarkets != null)
    {
        foreach (Market m in ViewBag.AllMarkets)
        {
            marketList.Add(new MarketDistanceDto { Market = m });
        }
    }
}

<nav class="breadcrumb-ml" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a><span>›</span><strong>Choose a market</strong>
</nav>

<div class="card-box">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <div>
            <h1 class="title" style="margin-bottom:6px">Markets near you</h1>
            @if (hasLocation)
            {
                <span class="muted">Sorted by straight-line distance from your current location.</span>
            }
            else
            {
                <span class="muted" id="locationStatus">Allow location access to see the markets closest to you.</span>
            }
        </div>
        <button type="button" class="btn-ml outline" onclick="useMyLocation()">@IconHelper.Icon("pin") @(hasLocation ? "Update my location" : "Use my location")</button>
    </div>

    @if (marketList.Count == 0)
    {
        <span class="muted">No markets yet.</span>
    }
    else
    {
        <div class="market-grid">
            @foreach (var item in marketList)
            {
                var m = item.Market;
                int stallCount = 0;
                foreach (var s in m.Stalls)
                {
                    if (s.IsActive) stallCount++;
                }
                <a class="market-card @(selectedMarketId == m.MarketId ? "on" : "")" asp-action="SelectMarket" asp-route-marketId="@m.MarketId">
                    @if (!string.IsNullOrEmpty(m.ImageUrl))
                    {
                        <img class="market-img" src="@m.ImageUrl" alt="@m.MarketName" loading="lazy" />
                    }
                    <span style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                        @if (selectedMarketId == m.MarketId)
                        {
                            <span class="badge-ml badge-green" style="height:26px;font-size:13px">@IconHelper.Icon("star", 14, true) Current</span>
                        }
                        else
                        {
                            <span class="badge-ml badge-green" style="height:26px;font-size:13px">@(m.District != null ? m.District.DistrictName : "")</span>
                        }
                        @if (item.DistanceKm != null)
                        {
                            <span class="distance">@IconHelper.Icon("pin", 16) @ShopHelper.Distance(item.DistanceKm)</span>
                        }
                        else if (hasLocation)
                        {
                            <span class="muted">Distance unknown</span>
                        }
                    </span>
                    <span class="name">@m.MarketName</span>
                    <span class="muted">@IconHelper.Icon("calendar") @ShopHelper.DayNames(m.OpenDays) · @ShopHelper.Hours(m.OpenTime, m.CloseTime)</span>
                    <span class="muted">@IconHelper.Icon("pin") @ShopHelper.MarketAddress(m)</span>
                    <span class="muted">@IconHelper.Icon("store") @stallCount @(stallCount == 1 ? "stall" : "stalls") selling</span>
                    <span class="go">Shop this market ›</span>
                </a>
            }
        </div>
    }
</div>

<div class="card-box" id="byDistrict">
    <h2 class="title" style="margin-bottom:6px">Or choose by district</h2>
    <p class="muted" style="margin:0 0 16px">Choose your city, then district, then the market you will visit.</p>

    <form asp-action="Index" method="get" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;align-items:end">
        <div class="field">
            <label for="cityId">City</label>
            <select id="cityId" name="cityId" asp-items="ViewBag.Cities" onchange="document.getElementById('districtId').value='';this.form.submit()">
                <option value="">-- Choose a city --</option>
            </select>
        </div>
        <div class="field">
            <label for="districtId">District</label>
            <select id="districtId" name="districtId" asp-items="ViewBag.Districts" onchange="this.form.submit()" disabled="@(ViewBag.CityId == null)">
                <option value="">-- Choose a district --</option>
            </select>
        </div>
    </form>
</div>

@if (ViewBag.DistrictId != null)
{
    <div class="card-box">
        <h2 class="title" style="margin-bottom:14px">Markets in this district</h2>

        @if (Model.Count == 0)
        {
            <div class="empty" style="border:none;padding:24px">
                <span class="t">No markets here yet</span>
                <span class="d">Try another district nearby, or use your location above.</span>
            </div>
        }
        else
        {
            <div class="market-grid">
                @foreach (var m in Model)
                {
                    <a class="market-card @(selectedMarketId == m.MarketId ? "on" : "")" asp-action="SelectMarket" asp-route-marketId="@m.MarketId">
                        @if (selectedMarketId == m.MarketId)
                        {
                            <span class="badge-ml badge-green" style="align-self:flex-start">@IconHelper.Icon("star", 14, true) Your current market</span>
                        }
                        @if (!string.IsNullOrEmpty(m.ImageUrl))
                        {
                            <img class="market-img" src="@m.ImageUrl" alt="@m.MarketName" loading="lazy" />
                        }
                        <span class="name">@m.MarketName</span>
                        <span class="muted">@IconHelper.Icon("calendar") @ShopHelper.DayNames(m.OpenDays) · @ShopHelper.Hours(m.OpenTime, m.CloseTime)</span>
                        <span class="muted">@IconHelper.Icon("pin") @ShopHelper.MarketAddress(m)</span>
                        <span class="go">Shop this market ›</span>
                    </a>
                }
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        var shopPageUrl = "@Url.Action("Index", "Shop")";
        var hasLocation = @(hasLocation ? "true" : "false");
        var hasDistrictFilter = @(hasDistrictFilter ? "true" : "false");

        function setLocationStatus(text, isError) {
            var status = document.getElementById("locationStatus");
            if (status) {
                status.innerText = text;
                status.style.color = isError ? "#B71C1C" : "";
            }
        }

        function useMyLocation() {
            if (!navigator.geolocation) {
                setLocationStatus("Your browser does not support location. Please choose your district below.", true);
                return;
            }

            setLocationStatus("Finding your location...", false);

            navigator.geolocation.getCurrentPosition(
                function (position) {
                    try { sessionStorage.removeItem("ml_location_denied"); } catch (e) { }
                    var lat = position.coords.latitude.toFixed(5);
                    var lng = position.coords.longitude.toFixed(5);
                    window.location.href = shopPageUrl + "?lat=" + lat + "&lng=" + lng;
                },
                function (error) {
                    try { sessionStorage.setItem("ml_location_denied", "1"); } catch (e) { }
                    if (error.code == 1) {
                        setLocationStatus("Location access was denied. Please choose your district below.", true);
                    } else {
                        setLocationStatus("Could not get your location. Please choose your district below.", true);
                    }
                },
                { timeout: 10000, maximumAge: 300000 }
            );
        }

        var deniedBefore = false;
        try { deniedBefore = sessionStorage.getItem("ml_location_denied") == "1"; } catch (e) { }

        if (!hasLocation && !hasDistrictFilter && !deniedBefore) {
            useMyLocation();
        }
    </script>
}
