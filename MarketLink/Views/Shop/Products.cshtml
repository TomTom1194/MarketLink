@model List<StockPrice>
@using MarketLink.Helpers
@{
    Market market = ViewBag.Market;
    List<ProductCategory> categories = ViewBag.Categories;
    string? keyword = ViewBag.Keyword;
    int? categoryId = ViewBag.CategoryId;
    string? sort = ViewBag.Sort;

    ViewData["Title"] = market.MarketName;
    Layout = "_ShopLayout";

    string categoryName = "";
    foreach (var c in categories)
    {
        if (c.CategoryId == categoryId)
        {
            categoryName = c.CategoryName;
        }
    }
}

<nav class="breadcrumb-ml" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a><span>›</span>
    <a asp-action="Products" asp-route-marketId="@market.MarketId">@market.MarketName</a>
    @if (categoryName != "")
    {
        <span>›</span><strong>@categoryName</strong>
    }
</nav>

<div class="card-box">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px">
        <div>
            <h1 class="title">@market.MarketName</h1>
            <span class="muted">@IconHelper.Icon("pin") <a href="@market.MapUrl" target="_blank">@ShopHelper.MarketAddress(market)</a> · @IconHelper.Icon("calendar") @ShopHelper.DayNames(market.OpenDays) · @ShopHelper.Hours(market.OpenTime, market.CloseTime)</span>
        </div>
        <a class="btn-ml outline" asp-action="Index">Change market</a>
    </div>

    <div class="cat-strip">
        <a class="chip @(categoryId == null ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-keyword="@keyword" asp-route-sort="@sort">All</a>
        @foreach (var c in categories)
        {
            if (c.ParentId == null)
            {
                <a class="chip @(categoryId == c.CategoryId ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-categoryId="@c.CategoryId" asp-route-keyword="@keyword" asp-route-sort="@sort">@c.CategoryName</a>
            }
        }
    </div>
</div>

<form asp-action="Products" method="get" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <input type="hidden" name="marketId" value="@market.MarketId" />
    <input type="hidden" name="categoryId" value="@categoryId" />
    <input type="hidden" name="sort" value="@sort" />
    <div class="field" style="flex:1;min-width:220px">
        <input name="keyword" value="@keyword" placeholder="Search in this market: product or farm name" aria-label="Search in this market" />
    </div>
    <button type="submit" class="btn-ml">Search</button>
    @if (!string.IsNullOrEmpty(keyword) || categoryId != null)
    {
        <a asp-action="Products" asp-route-marketId="@market.MarketId" style="font-size:14px;font-weight:700">Clear filters</a>
    }
</form>

<div class="sort-bar">
    <span class="lbl">Sort:</span>
    <a class="@(string.IsNullOrEmpty(sort) ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-keyword="@keyword" asp-route-categoryId="@categoryId">Newest</a>
    <a class="@(sort == "price_asc" ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-keyword="@keyword" asp-route-categoryId="@categoryId" asp-route-sort="price_asc">Price: low to high</a>
    <a class="@(sort == "price_desc" ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-keyword="@keyword" asp-route-categoryId="@categoryId" asp-route-sort="price_desc">Price: high to low</a>
    <a class="@(sort == "name" ? "on" : "")" asp-action="Products" asp-route-marketId="@market.MarketId" asp-route-keyword="@keyword" asp-route-categoryId="@categoryId" asp-route-sort="name">Name A–Z</a>
    <span class="count"><strong style="color:#1F2421">@Model.Count</strong> products</span>
</div>

@if (Model.Count == 0)
{
    <div class="empty">
        <span class="icon">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18l-2 9.2a2 2 0 0 1-2 1.8H7a2 2 0 0 1-2-1.8z"></path><path d="m8 10 4-6 4 6"></path></svg>
        </span>
        <span class="t">Nothing here yet</span>
        <span class="d">No products match at this market. Try another category or market.</span>
        <a class="btn-ml" asp-action="Products" asp-route-marketId="@market.MarketId">Clear filters</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var sp in Model)
        {
            <partial name="_ProductCard" model="sp" />
        }
    </div>
}
