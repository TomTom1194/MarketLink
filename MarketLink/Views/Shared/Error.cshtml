@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-box card-box" style="text-align:center;max-width:560px">
    <h1 class="title">Something went wrong</h1>
    <p class="muted" style="margin:0">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="muted" style="margin:0">Request ID: <code>@Model.RequestId</code></p>
    }

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn-ml outline">Back to home</a>
    </div>
</div>
