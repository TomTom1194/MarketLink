@using System.Security.Claims
@using MarketLink.Services
@inject IShopService ShopService
@inject ICartService CartService
@{
    Market? currentMarket = null;
    string? marketCookie = Context.Request.Cookies["MarketLink.MarketId"];
    int cookieMarketId;
    if (marketCookie != null && int.TryParse(marketCookie, out cookieMarketId))
    {
        currentMarket = await ShopService.GetMarketAsync(cookieMarketId);
    }

    bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
    bool isCustomer = isLoggedIn && User.IsInRole("customer");
    int basketCount = 0;
    if (isCustomer)
    {
        basketCount = await CartService.CountItemsAsync(int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!));
    }

    string displayName = isLoggedIn ? User.Identity!.Name ?? "" : "";
    string initial = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
</head>
<body class="shop">
<header class="ml-header">
    <div class="wrap">
        <a class="ml-logo" asp-controller="Home" asp-action="Index">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11h16l-1.6 7.4A2 2 0 0 1 16.4 20H7.6a2 2 0 0 1-2-1.6z"></path><path d="M8.5 11 11 6.5"></path><path d="M13 8.5c.5-3 3-4.5 6-4.5 0 3-2.5 5-6 4.5z" fill="#FFD400" stroke="#FFD400"></path></svg>
            <span>MarketLink</span>
        </a>

        <form class="ml-search" asp-controller="Shop" asp-action="Search" method="get">
            <input name="keyword" value="@Context.Request.Query["keyword"]" aria-label="Search all markets" placeholder="What are you looking for today?" required />
            <button type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>Search
            </button>
        </form>

        <a class="ml-pickup" asp-controller="Shop" asp-action="Index" title="Change market">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
            @if (currentMarket != null)
            {
                <span>Market: <strong>@currentMarket.MarketName</strong> @IconHelper.Icon("chevron-down", 14)</span>
            }
            else
            {
                <span>Choose a market @IconHelper.Icon("chevron-down", 14)</span>
            }
        </a>

        @if (!isLoggedIn)
        {
            <a class="ml-head-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"></path></svg>
                <span class="txt">Sign in</span>
            </a>
        }
        else
        {
            if (isCustomer)
            {
                <button type="button" class="ml-bell" aria-label="Notifications (coming soon)" title="Notifications – coming soon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
                </button>
                <a class="ml-head-link ml-user" asp-controller="MyOrders" asp-action="Index" title="My account">
                    <span class="ml-avatar">@initial</span><span class="txt ml-user-name">@displayName</span>
                </a>
            }
            else
            {
                <span class="ml-head-link ml-user"><span class="ml-avatar">@initial</span><span class="txt ml-user-name">@displayName</span></span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    <button type="submit" class="ml-head-link"><span class="txt">Log out</span>@IconHelper.Icon("logout")</button>
                </form>
            }
        }

        <a class="ml-basket" asp-controller="Cart" asp-action="Index">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18l-2 9.2a2 2 0 0 1-2 1.8H7a2 2 0 0 1-2-1.8z"></path><path d="m8 10 4-6 4 6"></path></svg>
            <span class="txt">Basket</span>
            <span class="ml-count">@basketCount</span>
        </a>
    </div>
</header>

<main class="wrap page">
    @if (TempData["Error"] != null)
    {
        <div class="alert-ml err" role="alert">@IconHelper.Icon("alert") @TempData["Error"]</div>
    }
    @RenderBody()
</main>

@if (TempData["Success"] != null)
{
    <div class="toast-ml" id="toastMessage" role="status">
        @IconHelper.Icon("check", 18)
        <span>@TempData["Success"]</span>
        <button type="button" class="toast-close" onclick="hideToast()" aria-label="Close">@IconHelper.Icon("x", 16)</button>
    </div>
}

<footer class="ml-footer">
    <div class="wrap cols">
        <div class="about">
            <span style="display:flex;align-items:center;gap:8px;color:#0B7A3E;font-size:22px;font-weight:800">MarketLink</span>
            <p style="margin:0;font-size:15px;line-height:1.6;color:#4A5550">Reserve from local farmers online. Pick up at the market and pay at the stall. No online payment, no delivery.</p>
            <div style="display:flex;flex-direction:column;gap:2px">
                <span style="font-size:14px;color:#5F6B65">Hotline (6:00 AM – 9:00 PM)</span>
                <a href="tel:18006868" style="font-size:24px;font-weight:800;text-decoration:none">1800 6868</a>
            </div>
        </div>
        <nav>
            <span>Shop</span>
            <a asp-controller="Shop" asp-action="Index">Choose a market</a>
            <a asp-controller="Shop" asp-action="Products">Products</a>
            <a asp-controller="Cart" asp-action="Index">Basket</a>
        </nav>
        <nav>
            <span>Account</span>
            <a asp-controller="MyOrders" asp-action="Index">My orders</a>
            <a asp-controller="Favorites" asp-action="Index">Favorite farmers</a>
            <a asp-controller="Account" asp-action="Register">Sign up</a>
        </nav>
    </div>
    <div class="wrap copy">© 2026 MarketLink. Pre-order online, pay in person at the market.</div>
</footer>

@if (isLoggedIn)
{
    <div class="modal-bg" id="reserveModal" role="dialog" aria-modal="true" aria-labelledby="reserveName" onclick="if (event.target == this) closeReserve()">
        <form class="modal-box reserve-box" id="reserveForm" asp-controller="Checkout" asp-action="ReserveNow" method="post" data-confirm="reserve">
            <input type="hidden" name="StockPriceId" id="reserveStockPriceId" />
            <input type="hidden" name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="button" class="reserve-close" onclick="closeReserve()" aria-label="Close">×</button>

            <div class="reserve-grid">
                <div class="reserve-left">
                    <div class="reserve-img">
                        <img id="reserveImage" src="" alt="" />
                    </div>
                    <div style="display:flex;flex-direction:column;gap:2px;min-width:0">
                        <span id="reserveName" style="font-size:19px;font-weight:800;line-height:1.3"></span>
                        <span class="muted" id="reserveStall"></span>
                        <span><span class="price" id="reservePrice" style="font-size:18px"></span> <span class="muted">/ <span id="reserveUnit"></span></span></span>
                    </div>
                    <div class="field">
                        <label for="reserveQuantity">Quantity <span class="muted" id="reserveLeft"></span></label>
                        <div class="qty-box sm">
                            <button type="button" aria-label="Decrease" onclick="changeReserveQuantity(-1)">–</button>
                            <input type="number" id="reserveQuantity" name="Quantity" value="1" min="1" step="1" oninput="updateReserveTotal()" />
                            <button type="button" aria-label="Increase" onclick="changeReserveQuantity(1)">+</button>
                        </div>
                    </div>
                </div>

                <div class="reserve-right">
                    <div class="note-yellow">@IconHelper.Icon("clock") <span>You will choose the pickup day and time in the next step.</span></div>
                    <div class="note-yellow" id="reserveNoDay" style="display:none">@IconHelper.Icon("alert") <span>This stall has no selling day in the next 7 days.</span></div>

                    <div style="display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #EEF1EF;padding-top:12px;margin-top:auto">
                        <span style="font-weight:700">Total</span>
                        <span class="total-big" id="reserveTotal" style="font-size:24px"></span>
                    </div>

                    <div class="reserve-actions">
                        <button type="submit" class="btn-ml btn-pad" id="reserveNowButton">RESERVE NOW</button>
                        <button type="submit" class="btn-ml outline btn-pad" formaction="@Url.Action("Add", "Cart")" formnovalidate>@IconHelper.Icon("basket") Add to basket</button>
                    </div>
                    <span class="muted" style="text-align:center">No payment now – pay the farmer at pickup.</span>
                </div>
            </div>
        </form>
    </div>

    <div class="modal-bg confirm-bg" id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="modal-box confirm-box">
            <span id="confirmTitle" style="font-size:20px;font-weight:800">Confirm your reservation</span>
            <div id="confirmBody" class="confirm-list"></div>
            <div class="confirm-pickup">
                <div class="field">
                    <label for="confirmDate">Pickup day</label>
                    <select id="confirmDate" onchange="buildConfirmSlots()"></select>
                </div>
                <div class="field">
                    <label>Pickup time</label>
                    <div class="slot-list" id="confirmSlots"></div>
                </div>
            </div>
            <div class="pay-note">@IconHelper.Icon("cash") No payment now – pay the farmer at pickup.</div>
            <div class="reserve-actions confirm-actions">
                <button type="button" class="btn-ml grey btn-pad" onclick="closeConfirm()">Go back</button>
                <button type="button" class="btn-ml btn-pad" id="confirmYesButton" onclick="acceptConfirm()">Yes, place order</button>
            </div>
        </div>
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/shop.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
