@model List<MarketLink.Models.Product>
@{
    ViewData["Title"] = "Products & kho";
    Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    var currentTime = DateTime.Now;
    var activeCount = Model.Count(product => product.Status == "active" && product.ExpiresAt > currentTime);
    var hiddenCount = Model.Count(product => product.Status == "hidden");
}

<style>
    .farmer-product-table thead th { background: #dfeee3; color: #24543a; border-bottom: 1px solid #bad9c3; white-space: nowrap; }
    .farmer-product-table tbody tr:nth-child(even) > * { background: #f4faf5; }
    .farmer-product-table tbody tr:hover > * { background: #eaf5ec; }
    .farmer-product-table tbody tr.product-expired > * { background: #fff1f2; }
    .farmer-product-table tbody tr.product-expired:hover > * { background: #ffe4e6; }
</style>

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h1 class="farmer-page-title">My products</h1>
        <p class="farmer-page-subtitle mb-0">Manage your products, stock, and listing expiry.</p>
    </div>
    <a asp-action="Create" class="btn farmer-btn-primary">+ Add product</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="badge rounded-pill text-bg-light border px-3 py-2">All: @Model.Count</span>
    <span class="badge rounded-pill text-bg-success px-3 py-2">Visible: @activeCount</span>
    <span class="badge rounded-pill text-bg-secondary px-3 py-2">Hidden: @hiddenCount</span>
</div>

<section class="farmer-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover farmer-product-table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Image</th><th>Products</th><th>Category</th><th>Unit</th><th>Status</th><th>Listing expires</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">You have no products yet.</td></tr>
                }
                @foreach (var product in Model)
                {
                    var expired = product.ExpiresAt <= currentTime;
                    var hasStock = product.StockPrices.Any(stock => stock.QuantityAvailable > 0);
                    <tr class="@(expired ? "product-expired" : "")">
                        <td><img src="@product.ImageUrl" alt="@product.ProductName" class="rounded-3 border @(expired ? "border-danger" : "")" style="width:48px;height:48px;object-fit:cover" /></td>
                        <td>
                            <div class="fw-semibold @(expired ? "text-danger" : "")">@product.ProductName</div>
                            <small class="text-muted">Listed: @product.PublishedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            @if (expired) { <div class="small text-danger fw-semibold mt-1">Listing expired. Re-up to extend it.</div> }
                        </td>
                        <td>@product.Category?.CategoryName</td>
                        <td>@product.Unit</td>
                        <td>
                            @if (expired) { <span class="badge text-bg-danger">Listing expired · Re-up needed</span> }
                            else if (!hasStock) { <span class="badge text-bg-warning">Out of stock · hidden</span> }
                            else if (product.Status == "hidden") { <span class="badge text-bg-secondary">Hidden</span> }
                            else { <span class="badge text-bg-success">Visible</span> }
                        </td>
                        <td class="@(expired ? "text-danger fw-semibold" : "")">@product.ExpiresAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Stock" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-info">Price & stock</a>
                                <a asp-action="Stock" asp-route-id="@product.ProductId" asp-fragment="reup" class="btn btn-sm @(expired ? "btn-danger" : "btn-outline-success")">@(expired ? "Re-up now" : "Re-up")</a>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProductId" value="@product.ProductId" />
                                    <input type="hidden" name="Status" value="@(product.Status == "hidden" ? "active" : "hidden")" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(product.Status == "hidden" ? "Show" : "Hide")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
