@{
    ViewData["Title"] = "Application sent";
    Layout = "_Layout";
    string? email = ViewBag.Email as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-6">
        <div class="card auth-card shadow-sm mt-4">
            <div class="card-body p-4 text-center">
                <h1 class="h4">Thank you, your application was sent</h1>
                <p class="text-muted mb-4">
                    Our team will review it soon.
                    @if (!string.IsNullOrEmpty(email))
                    {
                        <span>When it is approved, we will email a login link and password to <strong>@email</strong>.</span>
                    }
                    else
                    {
                        <span>When it is approved, we will email you a login link and password.</span>
                    }
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Back to home</a>
            </div>
        </div>
    </div>
</div>
