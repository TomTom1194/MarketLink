@{
    ViewData["Title"] = "Application sent";
    string? email = ViewBag.Email as string;
}

<div class="auth-box card-box" style="text-align:center;max-width:560px">
    <h1 class="title">Thank you, your application was sent</h1>
    <p class="muted" style="margin:0">
        Our team will review it soon.
        @if (!string.IsNullOrEmpty(email))
        {
            <span>When it is approved, we will email a login link and password to <strong>@email</strong>.</span>
        }
        else
        {
            <span>When it is approved, we will email you a login link and password.</span>
        }
    </p>
    <div>
        <a asp-controller="Home" asp-action="Index" class="btn-ml outline">Back to home</a>
    </div>
</div>
