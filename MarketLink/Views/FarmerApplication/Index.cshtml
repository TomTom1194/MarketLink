@model MarketLink.Dtos.FarmerApplicationDto
@using MarketLink.Dtos.Admin
@{
    ViewData["Title"] = "Sell on MarketLink";

    var markets = (List<Market>)ViewBag.Markets;
}

<div class="apply-box">
    <div>
        <h1 class="title">Apply to sell on MarketLink</h1>
        <p class="muted" style="margin:6px 0 0">
            Tell us about your farm and your stall. After our team approves your application,
            we email you a link and a password to log in.
        </p>
    </div>

    <form asp-action="Index" method="post" novalidate class="apply-form">
        <div asp-validation-summary="ModelOnly" class="alert-ml err" role="alert"></div>

        @* ===== 1. About you ===== *@
        <section class="card-box apply-section">
            <h2 class="title">1. About you</h2>
            <div class="app-grid">
                <div class="field">
                    <label asp-for="BrandName"></label>
                    <input asp-for="BrandName" placeholder="e.g. Co Ba Vegetable Garden" />
                    <span asp-validation-for="BrandName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ContactPerson"></label>
                    <input asp-for="ContactPerson" autocomplete="name" placeholder="Nguyen Van Ba" />
                    <span asp-validation-for="ContactPerson" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" placeholder="farm@gmail.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Phone"></label>
                    <input asp-for="Phone" autocomplete="tel" inputmode="numeric" placeholder="0901234567" />
                    <span asp-validation-for="Phone" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="CityId"></label>
                    <select asp-for="CityId" asp-items="ViewBag.Cities">
                        <option value="">-- Select a city --</option>
                    </select>
                    <span asp-validation-for="CityId" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="DistrictId"></label>
                    <select asp-for="DistrictId" asp-items="ViewBag.Districts">
                        <option value="">-- Select a district --</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="field-error"></span>
                </div>

                <div class="field full">
                    <label asp-for="Address"></label>
                    <input asp-for="Address" placeholder="Street number, street, ward" />
                    <span asp-validation-for="Address" class="field-error"></span>
                </div>

                <div class="field full">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" rows="2"
                              placeholder="e.g. Leafy greens and herbs, grown without chemical pesticides"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>
            </div>
        </section>

        @* ===== 2. Where do you sell? ===== *@
        <section class="card-box apply-section">
            <h2 class="title">2. Where do you sell?</h2>

            <div class="field">
                <label asp-for="MarketId"></label>
                <select asp-for="MarketId">
                    <option value="">-- Choose your market --</option>
                    @foreach (var city in markets.GroupBy(m => m.District!.City!.CityName))
                    {
                        <optgroup label="@city.Key">
                            @foreach (var market in city)
                            {
                                <option value="@market.MarketId"
                                        data-days="@MarketDays.ToDisplay(market.OpenDays)"
                                        data-hours="@(market.OpenTime.ToString("hh\\:mm"))–@(market.CloseTime.ToString("hh\\:mm"))">
                                    @market.MarketName — @(market.District!.DistrictName)
                                </option>
                            }
                        </optgroup>
                    }
                    <option value="@FarmerApplicationDto.OtherMarket">Other – my market is not listed</option>
                </select>
                <div id="market-hint" class="field-hint"></div>
                <span asp-validation-for="MarketId" class="field-error"></span>
            </div>

            @* Shown only when "Other" is chosen *@
            <div id="new-market" class="new-market-box" hidden="@(!Model.IsNewMarket)">
                <p class="muted" style="margin:0">
                    Tell us about your market. It will appear on MarketLink after our team approves your application.
                </p>
                <div class="app-grid">
                    <div class="field full">
                        <label asp-for="NewMarketName"></label>
                        <input asp-for="NewMarketName" placeholder="e.g. Tan My Market" />
                        <span asp-validation-for="NewMarketName" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="NewMarketCityId"></label>
                        <select asp-for="NewMarketCityId" asp-items="ViewBag.MarketCities">
                            <option value="">-- Select a city --</option>
                        </select>
                        <span asp-validation-for="NewMarketCityId" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="NewMarketDistrictId"></label>
                        <select asp-for="NewMarketDistrictId" asp-items="ViewBag.MarketDistricts">
                            <option value="">-- Select a district --</option>
                        </select>
                        <span asp-validation-for="NewMarketDistrictId" class="field-error"></span>
                    </div>

                    <div class="field full">
                        <label asp-for="NewMarketMapUrl"></label>
                        <input asp-for="NewMarketMapUrl" placeholder="https://maps.app.goo.gl/..." />
                        <div class="field-hint">On Google Maps, open the market, press Share and copy the link.</div>
                        <span asp-validation-for="NewMarketMapUrl" class="field-error"></span>
                    </div>

                    <div class="full">
                        <span class="day-label">Market days</span>
                        <div class="day-picks">
                            @foreach (var day in MarketDays.Names)
                            {
                                <label class="day-pick">
                                    <input type="checkbox" name="NewMarketOpenDays" value="@day.Key"
                                           checked="@Model.NewMarketOpenDays.Contains(day.Key)" />
                                    <span>@day.Value</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="NewMarketOpenDays" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="NewMarketOpenTime"></label>
                        <input asp-for="NewMarketOpenTime" type="time" asp-format="{0:hh\:mm}" />
                        <span asp-validation-for="NewMarketOpenTime" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="NewMarketCloseTime"></label>
                        <input asp-for="NewMarketCloseTime" type="time" asp-format="{0:hh\:mm}" />
                        <span asp-validation-for="NewMarketCloseTime" class="field-error"></span>
                    </div>
                </div>
            </div>
        </section>

        @* ===== 3. Your stall ===== *@
        <section class="card-box apply-section">
            <h2 class="title">3. Your stall</h2>
            <div class="app-grid">
                <div class="field">
                    <label asp-for="StallCode"></label>
                    <input asp-for="StallCode" placeholder="e.g. B-12" />
                    <span asp-validation-for="StallCode" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="StallGoogleUrl"></label>
                    <input asp-for="StallGoogleUrl" placeholder="https://maps.app.goo.gl/... (optional)" />
                    <span asp-validation-for="StallGoogleUrl" class="field-error"></span>
                </div>

                <div class="field full">
                    <label asp-for="StallLocationNote"></label>
                    <input asp-for="StallLocationNote" placeholder="e.g. Row B, next to gate 2 (optional)" />
                    <span asp-validation-for="StallLocationNote" class="field-error"></span>
                </div>

                <div class="full">
                    <span class="day-label">Days you sell</span>
                    <div class="day-picks">
                        @foreach (var day in MarketDays.Names)
                        {
                            <label class="day-pick">
                                <input type="checkbox" name="SellingDays" value="@day.Key"
                                       checked="@Model.SellingDays.Contains(day.Key)" />
                                <span>@day.Value</span>
                            </label>
                        }
                    </div>
                    <div class="field-hint">Only days when the market is open.</div>
                    <span asp-validation-for="SellingDays" class="field-error"></span>
                </div>
            </div>
        </section>

        <button type="submit" class="btn-ml block big">Send application</button>
    </form>

    <p class="auth-links" style="border:none;padding-top:0">
        <span>
            Already approved?
            <a asp-controller="Account" asp-action="Login">Log in</a>
        </span>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        var OTHER_MARKET = "@FarmerApplicationDto.OtherMarket";

        // Show the "new market" fields only when "Other" is chosen,
        // and show the chosen market's days and hours under the dropdown
        function updateMarketSection() {
            var selected = $("#MarketId option:selected");
            var value = selected.val();

            $("#new-market").prop("hidden", value !== OTHER_MARKET);

            if (!value) {
                $("#market-hint").text("Choose the market where your stall is, or Other if it is not listed.");
            } else if (value === OTHER_MARKET) {
                $("#market-hint").text("Fill in the market details below.");
            } else {
                $("#market-hint").text("Open " + selected.data("days") + ", " + selected.data("hours"));
            }
        }

        // Reload the districts of a city into a district dropdown
        function loadDistricts(cityId, districtSelect) {
            districtSelect.empty().append('<option value="">-- Select a district --</option>');

            if (!cityId) return;

            $.getJSON("@Url.Action("GetDistricts", "Account")", { cityId: cityId }, function (districts) {
                $.each(districts, function (i, d) {
                    districtSelect.append($("<option>").val(d.districtId).text(d.districtName));
                });
            });
        }

        // City of the address -> its districts
        $("#CityId").on("change", function () {
            loadDistricts($(this).val(), $("#DistrictId"));
        });

        // City of the new market -> its districts
        $("#NewMarketCityId").on("change", function () {
            loadDistricts($(this).val(), $("#NewMarketDistrictId"));
        });

        $("#MarketId").on("change", updateMarketSection);
        updateMarketSection();
    </script>
}
