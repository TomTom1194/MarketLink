@model MarketLink.Dtos.LoginDto
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-box card-box">
    <div>
        <h1 class="title">Log in</h1>
        <p class="muted" style="margin:6px 0 0">Pre-order fresh produce and pick it up at the stall.</p>
    </div>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate class="auth-form">
        <div asp-validation-summary="ModelOnly" class="alert-ml err" role="alert"></div>

        <div class="field">
            <label asp-for="EmailOrPhone"></label>
            <input asp-for="EmailOrPhone" autocomplete="username"
                   placeholder="e.g. lan@gmail.com or 0901234567" autofocus />
            <span asp-validation-for="EmailOrPhone" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <label class="auth-check">
            <input asp-for="RememberMe" />
            <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
        </label>

        <button type="submit" class="btn-ml block big">Log in</button>
    </form>

    <div class="auth-links">
        <p>
            Don't have an account?
            <a asp-action="Register">Sign up as a customer</a>
        </p>
        <p class="muted">
            Are you a farmer?
            <a asp-controller="FarmerApplication" asp-action="Index">Apply to sell on MarketLink</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
