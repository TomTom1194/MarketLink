@model MarketLink.Dtos.RegisterDto
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-box card-box" style="max-width:640px">
    <div>
        <h1 class="title">Create a customer account</h1>
        <p class="muted" style="margin:6px 0 0">Sign up to pre-order from markets near you.</p>
    </div>

    <form asp-action="Register" method="post" novalidate class="auth-form">
        <div asp-validation-summary="ModelOnly" class="alert-ml err" role="alert"></div>

        <div class="app-grid">
            <div class="field full">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" placeholder="Nguyen Thi Lan" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" placeholder="lan@gmail.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" autocomplete="tel" inputmode="numeric" placeholder="0901234567" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="CityId"></label>
                <select asp-for="CityId" asp-items="ViewBag.Cities">
                    <option value="">-- Select a city --</option>
                </select>
                <span asp-validation-for="CityId" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="DistrictId"></label>
                <select asp-for="DistrictId" asp-items="ViewBag.Districts">
                    <option value="">-- Select a district --</option>
                </select>
                <span asp-validation-for="DistrictId" class="field-error"></span>
            </div>

            <div class="field full">
                <label asp-for="Address"></label>
                <input asp-for="Address" autocomplete="street-address" placeholder="House number, street, ward" />
                <span asp-validation-for="Address" class="field-error"></span>
            </div>
        </div>

        <button type="submit" class="btn-ml block big">Sign up</button>
    </form>

    <div class="auth-links">
        <p>
            Already have an account?
            <a asp-action="Login">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // When the city changes, reload the districts of that city
        $("#CityId").on("change", function () {
            var cityId = $(this).val();
            var districtSelect = $("#DistrictId");

            districtSelect.empty().append('<option value="">-- Select a district --</option>');

            if (!cityId) return;

            $.getJSON("@Url.Action("GetDistricts", "Account")", { cityId: cityId }, function (districts) {
                $.each(districts, function (i, d) {
                    districtSelect.append($("<option>").val(d.districtId).text(d.districtName));
                });
            });
        });
    </script>
}
