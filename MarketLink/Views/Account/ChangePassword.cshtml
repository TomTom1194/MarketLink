@model ChangePasswordDto
@{
    ViewData["Title"] = "Change password";
    ViewData["AccountMenu"] = "password";

    // Farmers see this page inside the farmer portal, customers inside their account pages
    bool isFarmer = User.IsInRole("farmer");
    Layout = isFarmer ? "_FarmerLayout" : "_AccountLayout";

    // The two portals use different CSS (Bootstrap vs shop.css)
    string boxClass    = isFarmer ? "farmer-card p-3 p-md-4" : "card-box profile-form";
    string fieldClass  = isFarmer ? "mb-3" : "field";
    string labelClass  = isFarmer ? "form-label fw-semibold" : "";
    string inputClass  = isFarmer ? "form-control" : "";
    string errorClass  = isFarmer ? "text-danger small" : "field-error";
    string buttonClass = isFarmer ? "btn farmer-btn-primary px-4" : "btn-ml";
}

@if (isFarmer)
{
    <div class="mb-4">
        <h1 class="farmer-page-title">Change password</h1>
        <p class="farmer-page-subtitle mb-0">Use at least 6 characters. You stay logged in after changing it.</p>
    </div>
}
else
{
    <h1 class="title">Change password</h1>
    <p class="muted" style="margin:-6px 0 0">Use at least 6 characters. You stay logged in after changing it.</p>
}

<form asp-controller="Account" asp-action="ChangePassword" method="post" class="@boxClass" style="max-width:520px" novalidate>
    <div asp-validation-summary="ModelOnly" class="@(isFarmer ? "text-danger mb-3" : "alert-ml err")"></div>

    <div class="@fieldClass">
        <label asp-for="CurrentPassword" class="@labelClass"></label>
        <input asp-for="CurrentPassword" class="@inputClass" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="@errorClass"></span>
    </div>

    <div class="@fieldClass">
        <label asp-for="NewPassword" class="@labelClass"></label>
        <input asp-for="NewPassword" class="@inputClass" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="@errorClass"></span>
    </div>

    <div class="@fieldClass">
        <label asp-for="ConfirmNewPassword" class="@labelClass"></label>
        <input asp-for="ConfirmNewPassword" class="@inputClass" autocomplete="new-password" />
        <span asp-validation-for="ConfirmNewPassword" class="@errorClass"></span>
    </div>

    <div style="display:flex;justify-content:flex-end;margin-top:8px">
        <button type="submit" class="@buttonClass" style="min-width:180px">Change password</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
