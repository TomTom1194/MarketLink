@model IReadOnlyList<NotificationDto>
@{ ViewData["Title"] = "Notifications"; ViewData["AccountMenu"] = "notifications"; var unreadCount = (int)(ViewBag.UnreadCount ?? 0); }
<section class="farmer-page notifications-page">
    <div class="page-heading"><div><span class="eyebrow">LATEST UPDATES</span><h1>Notifications</h1><p>@(unreadCount > 0 ? unreadCount + " new " + (unreadCount == 1 ? "notification" : "notifications") + " since your last visit." : "No new notifications.")</p></div></div>
    <div class="order-tabs notification-tabs"><button class="order-tab active" data-notification-filter="all">All <span>@Model.Count</span></button><button class="order-tab" data-notification-filter="orders">Orders</button></div>
    @{ var productAlerts = (List<FarmerProductAlertDto>)ViewBag.ProductAlerts; }
    @if (productAlerts.Count > 0)
    {
        @* Sold out / expired products (worked out from Products + Stock_Price) *@
        <div class="notification-list" style="margin-bottom:18px">
            @foreach (var alert in productAlerts)
            {
                bool expired = alert.Kind == "expired";
                <article class="notification-card unread">
                    <span class="notification-icon orange">@(expired ? "⏱" : "∅")</span>
                    <div class="notification-copy">
                        <div class="notification-title">@alert.ProductName @(expired ? "listing has expired" : "is sold out")</div>
                        <p>@(expired ? "It is hidden from the shop." : "Customers can no longer order it.") Re-up with a new price, stock and listing period.</p>
                    </div>
                    <time datetime="@alert.Since.ToString("O")">@alert.Since.ToString("dd/MM/yyyy · HH:mm")</time>
                    <a asp-controller="FarmerProducts" asp-action="Reup" asp-route-id="@alert.ProductId" aria-label="Re-up product">›</a>
                </article>
            }
        </div>
    }
    <div class="notification-list">
        @if (Model.Count == 0)
        {
            <div class="empty-state"><span class="empty-icon">♧</span><h2>No notifications yet</h2><p>Updates about your orders will appear here.</p></div>
        }
        @foreach (var notification in Model)
        {
            var iconClass = notification.Type switch { "new_order" => "green", "order_accepted" => "blue", "order_rejected" or "order_cancelled" or "order_disputed" or "account_warning" => "orange", "order_completed" => "purple", "dispute_resolved" => "blue", _ => "gray" };
            var icon = notification.Type switch { "new_order" => "▣", "order_accepted" or "order_completed" => "✓", "order_rejected" or "order_cancelled" => "×", "order_disputed" or "account_warning" => "!", "dispute_resolved" => "✓", _ => "♧" };
            <article class="notification-card @(notification.IsRead ? "" : "unread")" data-kind="orders">
                <span class="notification-icon @iconClass">@icon</span>
                <div class="notification-copy"><div class="notification-title">@notification.Title @if (!notification.IsRead) { <span class="unread-dot"></span> }</div><p>@notification.Message</p></div>
                <time datetime="@notification.CreatedAt.ToString("O")">@notification.CreatedAt.ToString("dd/MM/yyyy · HH:mm")</time>
                @if (notification.OrderId.HasValue) { <a asp-controller="@(User.IsInRole("customer") ? "MyOrders" : "Orders")" asp-action="@(User.IsInRole("customer") ? "Detail" : "Details")" asp-route-id="@notification.OrderId" aria-label="View order">›</a> }
            </article>
        }
    </div>
</section>
@section Scripts { <script>document.querySelectorAll('[data-notification-filter]').forEach(tab => tab.addEventListener('click', () => { document.querySelectorAll('[data-notification-filter]').forEach(x => x.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('.notification-card').forEach(card => card.hidden = tab.dataset.notificationFilter !== 'all' && card.dataset.kind !== tab.dataset.notificationFilter); }));</script> }
