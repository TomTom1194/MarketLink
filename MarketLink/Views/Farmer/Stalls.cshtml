@model List<MarketLink.Dtos.FarmerStallResponseDto>
@{
    ViewData["Title"] = "Manage stall";
    Layout = "~/Views/Shared/_FarmerLayout.cshtml";
    var dayNames = new Dictionary<string, string>
    {
        ["1"] = "Sunday", ["2"] = "Monday", ["3"] = "Tuesday", ["4"] = "Wednesday",
        ["5"] = "Thursday", ["6"] = "Friday", ["7"] = "Saturday"
    };
}

<div class="mb-4">
    <h1 class="farmer-page-title">Manage stall</h1>
    <p class="farmer-page-subtitle">View your approved stall and update its selling days.</p>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <section class="farmer-card p-4">
        <h2 class="h5">No approved stall yet</h2>
        <p class="mb-0 text-muted">Your stall will appear here after the administrator approves your application.</p>
    </section>
}
else
{
    <div class="row g-3">
        @foreach (var stall in Model)
        {
            var selectedDays = (stall.SellingDays ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            <div class="col-12">
                <article class="farmer-card p-3 p-md-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <h2 class="h5 fw-bold text-success mb-1">@stall.MarketName</h2>
                            <div class="text-muted">Stall code: <strong>@stall.StallCode</strong></div>
                            @if (!string.IsNullOrWhiteSpace(stall.LocationNote))
                            {
                                <div class="small text-muted mt-1">Location: @stall.LocationNote</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(stall.MarketMapUrl))
                            {
                                <a href="@stall.MarketMapUrl" target="_blank" rel="noopener" class="small">View market location</a>
                            }
                        </div>
                        <span class="badge rounded-pill @(stall.IsActive ? "text-bg-success" : "text-bg-secondary")">
                            @(stall.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <form asp-controller="Farmer" asp-action="UpdateSellingDays" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stallId" value="@stall.StallId" />
                        <label class="form-label fw-semibold" for="days-@stall.StallId">Weekly selling days</label>
                        <div class="row g-2 mb-3" id="days-@stall.StallId">
                            @foreach (var day in dayNames)
                            {
                                <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                    <label class="form-check border rounded-3 p-2 ps-5">
                                        <input class="form-check-input" type="checkbox" name="dayChoice-@stall.StallId" value="@day.Key"
                                               data-stall="@stall.StallId" @(selectedDays.Contains(day.Key) ? "checked" : null) />
                                        <span class="form-check-label">@day.Value</span>
                                    </label>
                                </div>
                            }
                        </div>
                        <input type="hidden" name="SellingDays" id="sellingDays-@stall.StallId" value="@stall.SellingDays" />
                        <button type="submit" class="btn btn-sm farmer-btn-primary" onclick="return collectSellingDays(@stall.StallId)">Save selling days</button>
                    </form>
                </article>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        function collectSellingDays(stallId) {
            const checked = document.querySelectorAll(`input[data-stall="${stallId}"]:checked`);
            document.getElementById(`sellingDays-${stallId}`).value = Array.from(checked).map(item => item.value).join(',');
            if (checked.length === 0) {
                alert('Select at least one selling day.');
                return false;
            }
            return true;
        }
    </script>
}
