@model OrderDispute
@using MarketLink.Helpers
@using MarketLink.Services
@{
    ViewData["Title"] = "Pickup report";
    Layout = "_AdminLayout";

    var order = Model.Order!;
    var stall = order.Stall!;
    var farmer = stall.Farmer!;
    var customer = order.Customer!;
    int customerWarnings = ViewBag.CustomerWarnings;
    int farmerWarnings = ViewBag.FarmerWarnings;
    bool canResolve = ViewBag.CanResolve;
    DateTime replyDeadline = Model.CreatedAt.AddHours(DisputeService.ReplyHours);
}

<div class="toolbar">
    <a asp-action="Index" asp-route-status="@Model.Status" class="text-decoration-none">← All reports</a>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <h2 class="h4 m-0">Order #@order.OrderCode</h2>
    <span class="status-pill @(Model.Status == "open" ? "status-pending" : "status-hidden")">@(Model.Status == "open" ? "Waiting for decision" : "Closed")</span>
    <span class="text-muted">Reported by the @Model.ReportedBy on @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
</div>

<div class="row g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">

        <div class="row g-4">
            <div class="col-md-6">
                <div class="admin-card h-100">
                    <h3 class="h6 text-uppercase text-muted mb-2">Customer's side</h3>
                    <div class="fw-semibold">@customer.FullName</div>
                    <div class="small text-muted mb-3">@(customer.User != null ? customer.User.Phone + " · " + customer.User.Email : "") · Warnings: @customerWarnings/@DisputeService.MaxWarnings</div>
                    @if (Model.CustomerReason != null)
                    {
                        <p class="dispute-reason">@Model.CustomerReason</p>
                        <div class="small text-muted">Sent @Model.CustomerReasonAt!.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No answer yet.</p>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="admin-card h-100">
                    <h3 class="h6 text-uppercase text-muted mb-2">Farmer's side</h3>
                    <div class="fw-semibold">@farmer.BrandName</div>
                    <div class="small text-muted mb-3">@farmer.ContactPerson@(farmer.User != null ? " · " + farmer.User.Phone : "") · Warnings: @farmerWarnings/@DisputeService.MaxWarnings</div>
                    @if (Model.FarmerReason != null)
                    {
                        <p class="dispute-reason">@Model.FarmerReason</p>
                        <div class="small text-muted">Sent @Model.FarmerReasonAt!.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No answer yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="admin-card">
            <h3 class="h6 text-uppercase text-muted mb-3">Order</h3>
            <dl class="row mb-3">
                <dt class="col-sm-4">Market · stall</dt>
                <dd class="col-sm-8">@(stall.Market != null ? stall.Market.MarketName : "") · Stall @stall.StallCode</dd>

                <dt class="col-sm-4">Pickup time</dt>
                <dd class="col-sm-8">@order.PickupDate.ToString("dddd dd/MM/yyyy") · @ShopHelper.Hours(order.PickupFrom, order.PickupTo)</dd>

                <dt class="col-sm-4">Placed · accepted</dt>
                <dd class="col-sm-8">@order.PlacedAt.ToString("dd/MM HH:mm") · @(order.AcceptedAt != null ? order.AcceptedAt.Value.ToString("dd/MM HH:mm") : "-")</dd>

                <dt class="col-sm-4">Receiver</dt>
                <dd class="col-sm-8">@order.PickupName · @order.PickupPhone</dd>

                @if (!string.IsNullOrEmpty(order.CustomerNote))
                {
                    <dt class="col-sm-4">Customer note</dt>
                    <dd class="col-sm-8">@order.CustomerNote</dd>
                }
            </dl>
            <div class="d-flex flex-column gap-2">
                @foreach (var it in order.Items)
                {
                    <div class="d-flex align-items-center gap-3">
                        <img class="market-thumb" src="@it.ImageUrl" alt="" />
                        <span class="flex-grow-1">@it.ProductName</span>
                        <span class="text-muted">@ShopHelper.Qty(it.Quantity) @it.Unit</span>
                        <span class="num fw-semibold">@ShopHelper.Money(it.UnitPrice * it.Quantity)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card">
            @if (Model.Status == "resolved")
            {
                <h3 class="h6 text-uppercase text-muted mb-3">Decision</h3>
                <p class="mb-2">At fault: <strong>@(Model.AtFault == "customer" ? "Customer" : Model.AtFault == "farmer" ? "Farmer" : "No one")</strong></p>
                @if (!string.IsNullOrEmpty(Model.AdminNote))
                {
                    <p class="dispute-reason">@Model.AdminNote</p>
                }
                <div class="small text-muted">Closed @(Model.ResolvedAt != null ? Model.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")</div>
            }
            else
            {
                <h3 class="h6 text-uppercase text-muted mb-3">Decide</h3>
                @if (!canResolve)
                {
                    <div class="admin-alert warn mb-3">Waiting for the other side to answer. You can decide when both sides have answered, or after @replyDeadline.ToString("dd/MM/yyyy HH:mm").</div>
                }
                <form asp-action="Resolve" asp-route-id="@Model.DisputeId" method="post" class="d-flex flex-column gap-3"
                      onsubmit="return confirm('Close this case? The order will be cancelled and this cannot be undone.');">
                    <fieldset @(canResolve ? "" : "disabled")>
                        <legend class="form-label fw-semibold fs-6">Who is at fault?</legend>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="atFault" id="faultCustomer" value="customer" required />
                            <label class="form-check-label" for="faultCustomer">Customer <span class="text-muted">(warning @(customerWarnings + 1)/@DisputeService.MaxWarnings@(customerWarnings + 1 >= DisputeService.MaxWarnings ? " · account will be locked" : ""))</span></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="atFault" id="faultFarmer" value="farmer" />
                            <label class="form-check-label" for="faultFarmer">Farmer <span class="text-muted">(warning @(farmerWarnings + 1)/@DisputeService.MaxWarnings@(farmerWarnings + 1 >= DisputeService.MaxWarnings ? " · account will be locked" : ""))</span></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="atFault" id="faultNone" value="none" />
                            <label class="form-check-label" for="faultNone">No one <span class="text-muted">(reasonable cause)</span></label>
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-semibold" for="adminNote">Note to both sides (optional)</label>
                            <textarea class="form-control" id="adminNote" name="adminNote" rows="3" maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success mt-3 w-100">Close case</button>
                    </fieldset>
                </form>
                <div class="small text-muted mt-3">Closing cancels the order and puts the reserved quantity back on sale. The two reasons are never shown to the other side.</div>
            }
        </div>
    </div>
</div>
