@model List<CustomerRowDto>
@{
    ViewData["Title"] = "Customers";
    Layout = "_AdminLayout";

    string? status = ViewBag.Status;
    string? search = ViewBag.Search;
    int maxWarnings = MarketLink.Services.DisputeService.MaxWarnings;

    var tabs = new List<(string? Value, string Label)>
    {
        (null, "All"),
        ("active", "Active"),
        ("disabled", "Locked")
    };
}

<div class="toolbar">
    <ul class="nav nav-pills">
        @foreach (var tab in tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(status == tab.Value ? "active" : "")"
                   asp-action="Index" asp-route-status="@tab.Value" asp-route-search="@search">@tab.Label</a>
            </li>
        }
    </ul>

    <form method="get" asp-action="Index">
        <input type="hidden" name="status" value="@status" />
        <input type="search" name="search" value="@search" class="form-control" placeholder="Search name, email, phone" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="admin-card text-muted">No customers in this list.</div>
}
else
{
    <div class="risk-legend">
        <span><span class="risk-dot risk-dot-high"></span>1 more warning locks the account</span>
        <span><span class="risk-dot risk-dot-low"></span>Has a warning or a no-show order</span>
    </div>
    <div class="admin-table">
        <table class="table">
            <thead>
            <tr>
                <th>Customer</th>
                <th>Contact</th>
                <th>Area</th>
                <th>Joined</th>
                <th class="num">Orders</th>
                <th class="num">No-shows</th>
                <th class="num">Warnings</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var customer in Model)
            {
                // Highlight customers who do not pick up their orders (only while the account is still active)
                string risk = "";
                if (customer.Status == "active")
                {
                    if (customer.WarningCount >= maxWarnings - 1) risk = "risk-high";
                    else if (customer.WarningCount > 0 || customer.NoShowCount > 0) risk = "risk-low";
                }
                <tr class="@risk">
                    <td class="fw-semibold">@customer.FullName</td>
                    <td>
                        @customer.Phone<br />
                        <span class="small text-muted">@customer.Email</span>
                    </td>
                    <td>@customer.DistrictName, @customer.CityName</td>
                    <td class="text-nowrap">@customer.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="num">@customer.OrderCount</td>
                    <td class="num">@(customer.NoShowCount > 0 ? customer.NoShowCount.ToString() : "–")</td>
                    <td class="num">
                        @if (customer.WarningCount > 0)
                        {
                            <span class="warn-count @(customer.WarningCount >= maxWarnings - 1 ? "warn-high" : "")">@customer.WarningCount/@maxWarnings</span>
                        }
                        else
                        {
                            <span class="text-muted">0</span>
                        }
                    </td>
                    <td>
                        <span class="status-pill status-@customer.Status">
                            @(customer.Status == "active" ? "Active" : "Locked")
                        </span>
                    </td>
                    <td>
                        <div class="actions">
                            @if (customer.Status == "active")
                            {
                                <form asp-action="Lock" asp-route-id="@customer.UserId" method="post"
                                      onsubmit="return confirm('Lock this account? The customer will not be able to log in.');">
                                    <input type="hidden" name="returnStatus" value="@status" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Lock</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Unlock" asp-route-id="@customer.UserId" method="post">
                                    <input type="hidden" name="returnStatus" value="@status" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Unlock</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
