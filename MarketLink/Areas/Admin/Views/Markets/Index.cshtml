@model List<MarketRowDto>
@{
    ViewData["Title"] = "Markets";
    Layout = "_AdminLayout";
}

<div class="toolbar">
    <form method="get" asp-action="Index">
        <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search market name" />
        <select name="cityId" asp-items="ViewBag.Cities" class="form-select" style="width:auto">
            <option value="">All cities</option>
        </select>
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </form>
    <a class="btn btn-success" asp-action="Create">+ New market</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-card text-muted">No markets found. Create the first market so farmers can open stalls.</div>
}
else
{
    <div class="admin-table">
        <table class="table">
            <thead>
            <tr>
                <th>Market</th>
                <th>Area</th>
                <th>Market days</th>
                <th>Hours</th>
                <th class="num">Stalls</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var market in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(market.ImageUrl))
                            {
                                <img src="@market.ImageUrl" alt="" class="market-thumb" />
                            }
                            else
                            {
                                <div class="market-thumb market-thumb-empty">No photo</div>
                            }
                            <div>
                                <span class="fw-semibold">@market.MarketName</span><br />
                                <a class="small" href="@market.MapUrl" target="_blank" rel="noopener">Open in Google Maps</a>
                            </div>
                        </div>
                    </td>
                    <td>@market.DistrictName, @market.CityName</td>
                    <td>@MarketDays.ToDisplay(market.OpenDays)</td>
                    <td class="text-nowrap">@(market.OpenTime.ToString("hh\\:mm")) – @(market.CloseTime.ToString("hh\\:mm"))</td>
                    <td class="num">@market.StallCount</td>
                    <td>
                        @if (market.IsActive)
                        {
                            <span class="status-pill status-active">Active</span>
                        }
                        else if (market.IsSuggested)
                        {
                            <span class="status-pill status-pending" title="Shown when the farmer who suggested it is approved">Suggested by farmer</span>
                        }
                        else
                        {
                            <span class="status-pill status-hidden">Hidden</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@market.MarketId">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@market.MarketId" method="post">
                                <button type="submit" class="btn btn-sm @(market.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(market.IsActive ? "Hide" : "Show")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
