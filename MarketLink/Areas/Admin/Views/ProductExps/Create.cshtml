@model ProductExpFormDto
@{
    ViewData["Title"] = "New display period";
    Layout = "_AdminLayout";
}

<div class="admin-card form-card">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_ProductExpForm" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-success">Create period</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
