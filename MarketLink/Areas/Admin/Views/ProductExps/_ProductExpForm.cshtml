@model ProductExpFormDto
@* Fields shared by Create.cshtml and Edit.cshtml *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="ExpCode" class="form-label"></label>
        <input asp-for="ExpCode" class="form-control text-uppercase" placeholder="SHORT" />
        <span asp-validation-for="ExpCode" class="text-danger small"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="ExpName" class="form-label"></label>
        <input asp-for="ExpName" class="form-control" placeholder="Short term" />
        <span asp-validation-for="ExpName" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="DurationDays" class="form-label"></label>
        <input asp-for="DurationDays" class="form-control" min="1" max="365" />
        <span asp-validation-for="DurationDays" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" placeholder="e.g. Leafy greens, ripe fruit, fresh milk" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
