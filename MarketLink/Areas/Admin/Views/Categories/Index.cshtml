@model List<CategoryRowDto>
@{
    ViewData["Title"] = "Product categories";
    Layout = "_AdminLayout";
}

<div class="toolbar">
    <p class="text-muted m-0">Farmers pick one of these categories when they post a product. Hidden categories are not offered.</p>
    <a class="btn btn-success" asp-action="Create">+ New category</a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-card text-muted">No categories yet. Add a few, e.g. Vegetables, Fruit, Dairy &amp; eggs, Bakery.</div>
}
else
{
    <div class="admin-table">
        <table class="table">
            <thead>
            <tr>
                <th>Category</th>
                <th>Slug</th>
                <th class="num">Products</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>
                        @if (category.ParentId != null)
                        {
                            <span><span class="text-muted ms-3">↳</span> @category.CategoryName</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@category.CategoryName</span>
                        }
                    </td>
                    <td><code>@category.Slug</code></td>
                    <td class="num">@category.ProductCount</td>
                    <td>
                        @if (category.IsActive)
                        {
                            <span class="status-pill status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-pill status-hidden">Hidden</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.CategoryId">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@category.CategoryId" method="post">
                                <button type="submit" class="btn btn-sm @(category.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    @(category.IsActive ? "Hide" : "Show")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
